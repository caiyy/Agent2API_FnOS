#!/bin/bash

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

LOG_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.pid"
SVC_CWD="${TRIM_PKGVAR}"
SVC_BACKGROUND=y
SVC_WRITE_PID=y
SVC_QUIET=y
SVC_WAIT_TIMEOUT=30

validate_paths() {
    if [ -z "${TRIM_APPDEST:-}" ] || [ -z "${TRIM_PKGVAR:-}" ] || [ -z "${TRIM_APPNAME:-}" ]; then
        echo "Agent2API: missing required fnOS lifecycle variables" >&2
        return 1
    fi
    case "${TRIM_PKGVAR}" in
        /vol*|/usr/local/apps/@appdata/*) ;;
        *)
            echo "Agent2API: refusing unexpected data path ${TRIM_PKGVAR}" >&2
            return 1
            ;;
    esac
}

error_exit() {
    local message="$1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "${message}" > "${TRIM_TEMP_LOGFILE}"
    fi
    printf 'ERROR: %s\n' "${message}" >&2
    exit 1
}

validate_preinst() { :; }
service_preinst() { :; }
service_postinst() { :; }
service_preuninst() { :; }
service_postuninst() { :; }
validate_preupgrade() { :; }
service_preupgrade() { :; }
service_save() { :; }
service_restore() { :; }
service_postupgrade() { :; }
service_preconfig() { :; }
service_postconfig() { :; }

call_hook() {
    local name="$1"
    if declare -F "${name}" >/dev/null 2>&1; then
        printf '==> %s\n' "${name}" >> "${LOG_FILE}"
        "${name}" >> "${LOG_FILE}" 2>&1
    fi
}

service_process_pids() {
    local pid
    for proc in /proc/[0-9]*; do
        [ -d "${proc}" ] || continue
        pid="${proc##*/}"
        [ "${pid}" = "$$" ] && continue
        if service_pid_is_live "${pid}" && service_pid_matches_binary "${pid}"; then
            printf '%s\n' "${pid}"
        fi
    done
}

service_pid_is_live() {
    local pid="$1"
    kill -0 "${pid}" >/dev/null 2>&1 || return 1
    if [ -r "/proc/${pid}/stat" ]; then
        local state
        state="$(sed -nE 's/^[0-9]+ \(.*\) ([A-Z]).*/\1/p' "/proc/${pid}/stat")"
        [ "${state}" != "Z" ] || return 1
    fi
    return 0
}

service_pid_matches_binary() {
    local pid="$1"
    [ -n "${SERVICE_BINARY:-}" ] || return 0
    local actual expected arg count=0
    expected="$(readlink -f "${SERVICE_BINARY}" 2>/dev/null || printf '%s' "${SERVICE_BINARY}")"
    [ -n "${expected}" ] || return 0

    if [ -r "/proc/${pid}/exe" ]; then
        actual="$(readlink -f "/proc/${pid}/exe" 2>/dev/null || true)"
        actual="${actual% (deleted)}"
        [ -n "${actual}" ] && [ "${actual}" = "${expected}" ] && return 0
    fi

    # QEMU cross-architecture containers expose the emulator through /proc/exe;
    # the emulated binary remains visible in the first few command-line args.
    if [ -r "/proc/${pid}/cmdline" ]; then
        while IFS= read -r -d '' arg; do
            count=$((count + 1))
            [ "${count}" -le 3 ] || break
            case "${arg}" in
                /*)
                    actual="$(readlink -f "${arg}" 2>/dev/null || true)"
                    [ "${actual}" = "${expected}" ] && return 0
                    ;;
            esac
        done < "/proc/${pid}/cmdline"
    fi
    return 1
}

service_pid_alive() {
    local pid="$1"
    service_pid_is_live "${pid}" || return 1
    service_pid_matches_binary "${pid}" || return 1
    return 0
}

daemon_status() {
    local pid_file="${1:-${PID_FILE}}"
    local pid seen=0 discovered
    if [ -r "${pid_file}" ]; then
        while IFS= read -r pid; do
            [ -n "${pid}" ] || continue
            seen=1
            service_pid_alive "${pid}" || {
                seen=0
                break
            }
        done < "${pid_file}"
        [ "${seen}" -eq 1 ] && return 0
        rm -f "${pid_file}"
    fi

    discovered="$(service_process_pids)"
    if [ -n "${discovered}" ]; then
        printf '%s\n' "${discovered}" > "${PID_FILE}"
        return 0
    fi
    return 1
}

start_daemon() {
    validate_paths || return 1
    if daemon_status; then
        return 0
    fi
    [ -x "${SERVICE_BINARY}" ] || {
        echo "Agent2API: executable not found: ${SERVICE_BINARY}" >&2
        return 1
    }
    mkdir -p "${SVC_CWD}" || return 1
    : > "${LOG_FILE}"
    call_hook service_prestart
    (
        cd "${SVC_CWD}" || exit 1
        exec "${SERVICE_BINARY}"
    ) >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf '%s\n' "${pid}" > "${PID_FILE}"

    local waited=0
    while [ "${waited}" -lt "${SVC_WAIT_TIMEOUT}" ]; do
        if ! service_pid_alive "${pid}"; then
            rm -f "${PID_FILE}"
            echo "Agent2API failed to start; see ${LOG_FILE}" >&2
            return 1
        fi
        if [ "${waited}" -ge 1 ] && command -v curl >/dev/null 2>&1; then
            if curl -fsS --max-time 2 "http://127.0.0.1:${AGENT2API_PROXY_PORT:-3065}/health" >/dev/null 2>&1; then
                return 0
            fi
        elif [ "${waited}" -ge 1 ]; then
            if (exec 3<>"/dev/tcp/127.0.0.1/${AGENT2API_PROXY_PORT:-3065}") 2>/dev/null; then
                return 0
            fi
        fi
        sleep 1
        waited=$((waited + 1))
    done
    if service_pid_alive "${pid}"; then
        echo "Agent2API is still starting after ${SVC_WAIT_TIMEOUT}s; continuing." >&2
        return 0
    fi
    rm -f "${PID_FILE}"
    return 1
}

stop_daemon() {
    local pid pids waited alive
    pids="$(cat "${PID_FILE}" 2>/dev/null || true)"
    pids="${pids}
$(service_process_pids)"
    for pid in ${pids}; do
        service_pid_alive "${pid}" && kill -TERM "${pid}" 2>/dev/null || true
    done
    waited=0
    while [ "${waited}" -lt "${SVC_WAIT_TIMEOUT}" ]; do
        alive=0
        for pid in ${pids}; do
            service_pid_alive "${pid}" && alive=1
        done
        [ "${alive}" -eq 0 ] && break
        sleep 1
        waited=$((waited + 1))
    done
    for pid in ${pids}; do
        service_pid_alive "${pid}" && kill -KILL "${pid}" 2>/dev/null || true
    done
    rm -f "${PID_FILE}"
    call_hook service_poststop
}

cleanup_service_processes() {
    local pid
    for pid in $(service_process_pids); do
        service_pid_alive "${pid}" && kill -TERM "${pid}" 2>/dev/null || true
    done
    sleep 1
    for pid in $(service_process_pids); do
        service_pid_alive "${pid}" && kill -KILL "${pid}" 2>/dev/null || true
    done
    rm -f "${PID_FILE}"
}

install_init() {
    validate_paths || error_exit "Agent2API data path validation failed"
    call_hook validate_preinst
    call_hook service_preinst
}

install_callback() {
    mkdir -p "${TRIM_PKGVAR}/logs"
    call_hook service_postinst
}

uninstall_init() {
    stop_daemon
    call_hook service_preuninst
}

uninstall_callback() {
    call_hook service_postuninst
}

upgrade_init() {
    stop_daemon
    call_hook validate_preupgrade
    call_hook service_preupgrade
    call_hook service_save
}

upgrade_callback() {
    mkdir -p "${TRIM_PKGVAR}/logs"
    call_hook service_restore
    call_hook service_postupgrade
}

config_init() {
    call_hook service_preconfig
}

config_callback() {
    call_hook service_postconfig
}
