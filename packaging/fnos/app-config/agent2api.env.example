# Agent2API fnOS configuration.
#
# This file is copied to the application data directory on first start:
#   <application data>/agent2api.env
# Restart the application after editing it.

# Listen on every NAS interface so other devices can use the gateway.
AGENT2API_HOST=0.0.0.0

# The port is managed by fnOS. Leave this unset to follow the port assigned in
# Application Center. Only set it if you also change the package port.
#AGENT2API_PROXY_PORT=3065

# Account registration can be done in the web panel. To pre-provision an
# administrator for unattended deployment, set both values before first start.
#AGENT2API_ADMIN_USER=admin
#AGENT2API_ADMIN_PASSWORD=

# Login challenge is enabled by default.
AGENT2API_CAPTCHA_ENABLED=1

# Optional memory limits for image caches (MiB).
#AGENT2API_IMAGE_CACHE_MB=128
#AGENT2API_IMAGE_COMPRESS_CACHE_MB=128

# Optional debug logging.
#AGENT2API_VERBOSE=1
